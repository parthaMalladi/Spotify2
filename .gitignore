# =========================
# Audio library (never commit)
# =========================

# Ignore everything in song_files except the placeholder that keeps the folder in git
/song_files/*
!/song_files/.gitkeep

# =========================
# Python / Django (backend)
# =========================

# Virtual environments
backend/.venv/
backend/venv/
.venv/
venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/

# Django local files
*.sqlite3
*.sqlite3-journal
backend/media/
backend/staticfiles/

# Test and tooling output
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
*.log

# Environment variables / secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.*
!frontend/.env.example

# =========================
# React / Vite (frontend)
# =========================

frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# =========================
# Claude Code (personal settings only; CLAUDE.md IS committed)
# =========================

.claude/settings.local.json

# =========================
# Editors and operating system
